{
  "name": "sow-by-season",
  "version": "1.11.3",
  "private": true,
  "description": "Sow by Season by BearyNatural — an Australian garden-planning assistant.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "tsx --test --test-reporter=spec tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:domain": "tsc -p tsconfig.domain.json",
    "data:ga-windows": "node scripts/build-ga-windows.mjs",
    "export:web": "expo export --platform web",
    "doctor": "npx expo-doctor",
    "audit:prod": "node ../repo-tools/audit-with-exceptions.mjs"
  },
  "dependencies": {
    "@expo/dom-webview": "~57.0.1",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.31",
    "expo-background-task": "~57.0.21",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.4",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-notifications": "~57.0.24",
    "expo-router": "~57.0.29",
    "expo-sharing": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.21",
    "expo-web-browser": "~57.0.3",
    "leaflet": "^1.9.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-android-widget": "^0.22.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
