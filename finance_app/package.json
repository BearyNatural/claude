{
  "name": "geranium-finance",
  "productName": "Geranium",
  "version": "0.3.0",
  "private": true,
  "description": "Local-first personal finance, budgeting and planning for Australian households. A tracking, understanding and planning tool — not financial advice.",
  "author": "BearyNatural",
  "homepage": "https://github.com/BearyNatural/claude/tree/main/finance_app",
  "license": "UNLICENSED",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/build.mjs --dev && electron .",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "node scripts/build.mjs",
    "build:web": "vite build --config vite.web.config.ts",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "npm run build && electron-builder --publish never",
    "package:linux": "npm run build && electron-builder --linux AppImage --publish never",
    "package:win": "npm run build && electron-builder --win nsis --publish never",
    "package:mac": "npm run build && electron-builder --mac dmg --publish never"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "buffer": "^6.0.3",
    "fflate": "^0.8.3",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.3.289",
    "sql.js": "^1.14.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
